// NetOps AI - Prisma schema
// Phase 1: authentication (User) and reference data (Vendor, DeviceType, Technology).
// Phase 2: case management core (TroubleshootingCase, TroubleshootingStep, AuditLog).
// Phase 3: knowledge base (KnowledgeBaseArticle), optionally linked back to the
// case it was authored from.
// Phase 4: command catalog (CommandCatalogEntry), a searchable reference of
// vendor/device/technology-scoped commands. TroubleshootingStep carries an
// optional link to a catalog entry, ready for a later phase to wire up.
// Phase 5: semantic search (ContentEmbedding) over published KnowledgeBaseArticle
// and CommandCatalogEntry content. Vectors are stored as a plain float array -
// no pgvector extension is available in this environment - and similarity is
// computed in application code (see lib/embeddings/). The storage/search split
// is deliberately abstracted so a pgvector-backed index can replace the
// in-app ranking later without changing callers.
//
// Not in scope yet (added in later phases): AI-generated step content (fields
// are present and ready on TroubleshootingStep, but nothing populates them yet).

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ENGINEER
  VIEWER
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum StepType {
  COMMAND
  NOTE
  AI_ANALYSIS
  NEXT_STEP_RECOMMENDATION
  STATUS_CHANGE
}

enum ApprovalState {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CommandStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EmbeddingSourceType {
  KB_ARTICLE
  COMMAND_CATALOG_ENTRY
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(ENGINEER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdCases    TroubleshootingCase[]  @relation("CaseCreatedBy")
  performedSteps  TroubleshootingStep[]  @relation("StepPerformedBy")
  approvedSteps   TroubleshootingStep[]  @relation("StepApprovedBy")
  auditLogs       AuditLog[]
  createdArticles KnowledgeBaseArticle[] @relation("ArticleCreatedBy")
  updatedArticles KnowledgeBaseArticle[] @relation("ArticleUpdatedBy")
  createdCommands CommandCatalogEntry[]  @relation("CommandCreatedBy")
  updatedCommands CommandCatalogEntry[]  @relation("CommandUpdatedBy")
}

model Vendor {
  id          String                 @id @default(cuid())
  name        String                 @unique
  slug        String                 @unique
  createdAt   DateTime               @default(now())
  deviceTypes DeviceType[]
  cases       TroubleshootingCase[]
  articles    KnowledgeBaseArticle[]
  commands    CommandCatalogEntry[]
}

model DeviceType {
  id        String                @id @default(cuid())
  name      String
  vendorId  String
  vendor    Vendor                @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdAt DateTime              @default(now())
  cases     TroubleshootingCase[]
  commands  CommandCatalogEntry[]

  @@unique([vendorId, name])
}

model Technology {
  id        String                 @id @default(cuid())
  name      String                 @unique
  slug      String                 @unique
  createdAt DateTime               @default(now())
  cases     TroubleshootingCase[]
  articles  KnowledgeBaseArticle[]
  commands  CommandCatalogEntry[]
}

model TroubleshootingCase {
  id           String     @id @default(cuid())
  title        String
  description  String
  vendorId     String
  vendor       Vendor     @relation(fields: [vendorId], references: [id])
  deviceTypeId String
  deviceType   DeviceType @relation(fields: [deviceTypeId], references: [id])
  technologyId String
  technology   Technology @relation(fields: [technologyId], references: [id])
  severity     Severity
  status       CaseStatus @default(OPEN)
  createdById  String
  createdBy    User       @relation("CaseCreatedBy", fields: [createdById], references: [id])

  // Populated when the case is resolved.
  rootCause    String?
  resolution   String?
  verification String?
  resolvedAt   DateTime?

  // Soft delete only - see AGENTS.md safety rule on not deleting history
  // without explicit confirmation.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps      TroubleshootingStep[]
  kbArticles KnowledgeBaseArticle[]

  @@index([status])
  @@index([vendorId])
  @@index([deletedAt])
}

model TroubleshootingStep {
  id     String              @id @default(cuid())
  caseId String
  case   TroubleshootingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type   StepType

  // COMMAND fields
  commandText    String?
  commandOutput  String?
  isConfigChange Boolean       @default(false)
  approvalState  ApprovalState @default(NOT_REQUIRED)
  approvedById   String?
  approvedBy     User?         @relation("StepApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?

  // NOTE / STATUS_CHANGE fields
  note String?

  // AI fields - not populated until the AI integration phase.
  aiAnalysis          String?
  recommendedNextStep String?
  aiModel             String?

  // Optional link to the catalog entry this COMMAND step's command came
  // from. Schema-ready for Phase 4; no UI wires this up yet.
  commandCatalogEntryId String?
  commandCatalogEntry   CommandCatalogEntry? @relation(fields: [commandCatalogEntryId], references: [id])

  performedById String
  performedBy   User     @relation("StepPerformedBy", fields: [performedById], references: [id])
  createdAt     DateTime @default(now())

  @@index([caseId])
  @@index([commandCatalogEntryId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
}

model KnowledgeBaseArticle {
  id      String        @id @default(cuid())
  title   String
  slug    String        @unique
  summary String
  content String
  status  ArticleStatus @default(DRAFT)

  vendorId     String?
  vendor       Vendor?     @relation(fields: [vendorId], references: [id])
  technologyId String?
  technology   Technology? @relation(fields: [technologyId], references: [id])

  // Optional link back to the case this article was authored from.
  sourceCaseId String?
  sourceCase   TroubleshootingCase? @relation(fields: [sourceCaseId], references: [id])

  createdById String
  createdBy   User    @relation("ArticleCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("ArticleUpdatedBy", fields: [updatedById], references: [id])

  // Soft delete only - see AGENTS.md safety rule on not deleting history
  // without explicit confirmation.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  embedding ContentEmbedding?

  @@index([status])
  @@index([vendorId])
  @@index([technologyId])
  @@index([deletedAt])
}

model CommandCatalogEntry {
  id             String  @id @default(cuid())
  slug           String  @unique
  title          String
  commandText    String
  description    String
  purpose        String?
  expectedOutput String?

  vendorId     String
  vendor       Vendor      @relation(fields: [vendorId], references: [id])
  deviceTypeId String?
  deviceType   DeviceType? @relation(fields: [deviceTypeId], references: [id])
  technologyId String?
  technology   Technology? @relation(fields: [technologyId], references: [id])

  riskLevel      RiskLevel     @default(LOW)
  isConfigChange Boolean       @default(false)
  status         CommandStatus @default(DRAFT)

  createdById String
  createdBy   User    @relation("CommandCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("CommandUpdatedBy", fields: [updatedById], references: [id])

  // Soft delete only - see AGENTS.md safety rule on not deleting history
  // without explicit confirmation.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps     TroubleshootingStep[]
  embedding ContentEmbedding?

  @@index([status])
  @@index([vendorId])
  @@index([deviceTypeId])
  @@index([technologyId])
  @@index([riskLevel])
  @@index([deletedAt])
  @@index([vendorId, deviceTypeId])
}

/// Stores one vector per searchable source (a KnowledgeBaseArticle or a
/// CommandCatalogEntry - exactly one of kbArticleId/commandId is set, enforced
/// in lib/embeddings/indexer.ts rather than a DB constraint, matching this
/// schema's existing convention of enforcing cross-field business rules in
/// code). No pgvector extension is available in this environment, so the
/// vector is a plain Float[] and similarity is computed in application code
/// (see lib/embeddings/similarity.ts) - swapping in a pgvector index later
/// only touches that layer, not this table's shape.
model ContentEmbedding {
  id         String              @id @default(cuid())
  sourceType EmbeddingSourceType

  kbArticleId String?               @unique
  kbArticle   KnowledgeBaseArticle? @relation(fields: [kbArticleId], references: [id], onDelete: Cascade)
  commandId   String?               @unique
  command     CommandCatalogEntry?  @relation(fields: [commandId], references: [id], onDelete: Cascade)

  // Exact text that was embedded, and its hash - re-indexing compares the
  // current content's hash against this to skip unchanged-content API calls.
  content     String
  contentHash String
  embedding   Float[]

  // Which provider/model/dimensionality produced this vector, so a future
  // model or provider change can be detected and force a re-embed.
  model      String
  dimensions Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceType])
  @@index([contentHash])
}
