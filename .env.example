# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/netops_ai?schema=public"

# Auth.js (NextAuth v5) signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Optional Phase 5 semantic search provider.
VOYAGE_API_KEY=""

# Optional Phase 6 AI troubleshooting analysis.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-20250514"
